APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Absolute Python interpreter path; leave unset to use scraper/.venv/bin/python.
# RISENGROWTH_PYTHON=/absolute/path/to/project/scraper/.venv/bin/python
# Must exceed the 110-second discovery job timeout.
DB_QUEUE_RETRY_AFTER=150

# Optional local AI. Discovery and free draft templates work without it.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Apify feasibility probe only. No automatic Apify schedules are enabled yet.
APIFY_TOKEN=
APIFY_PROBE_DAILY_RUNS=1
APIFY_PROBE_MAX_CHARGE_USD=0.05
APIFY_MONTHLY_BUDGET_USD=4.50
APIFY_MAX_POST_AGE_DAYS=14
THREADS_EXCLUDED_USERNAMES=risencode.dev,risendev

# Default engine preselected on the Discovery page: apify (default) or scrapling.
SCRAPER_ENGINE=apify
# Scrapling Threads engine (needs scraper/.venv, see SCRAPLING-ENGINE.md). No Apify token required.
# Mode: http (lightweight, default) or browser (JS rendering, needs `scrapling install`).
# SCRAPLING_MODE=http
# SCRAPLING_TIMEOUT=20
# SCRAPLING_MAX_POSTS=20
# Browser mode only: how many times to scroll the search page for more posts (0-15).
# SCRAPLING_SCROLLS=5
# Default date range when the form leaves it empty: today minus N days up to today (WIB).
# SCRAPLING_MAX_POST_AGE_DAYS=7
# Minimum gap between Scrapling jobs (plus up to 50% random jitter), and the pause after LOGIN_WALL/403/429.
# SCRAPLING_COOLDOWN_SECONDS=60
# SCRAPLING_BLOCK_BACKOFF_SECONDS=900
